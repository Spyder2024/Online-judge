# Production Environment Configuration for Vercel Deployment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI-Enhanced Online Judge Platform"
API_V1_STR="/api/v1"

# Security / JWT Authentication (Generate a long random secret key)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Managed PostgreSQL Database with pgvector (Neon.tech)
# Replace credentials and endpoint with your Neon database URL:
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Managed Redis Cache Pool (Upstash.com)
# Replace with your Upstash Redis rediss:// URL:
REDIS_URL=rediss://default:password@xyz.upstash.io:6379
REDIS_POOL_SIZE=10

# Compiler Microservice Endpoint (Deploy on Render or Railway if separate microservice is used)
COMPILER_ENGINE_URL=http://compiler-engine:8000/run
COMPILER_ENGINE_FALLBACK_URL=http://127.0.0.1:8000/run

# OAuth 2.0 Base URL (Your Vercel app domain)
OAUTH_REDIRECT_BASE_URL=https://<your-vercel-app>.vercel.app

# Google OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth Credentials (GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
